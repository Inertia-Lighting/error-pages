HTTP/1.0 403 Forbidden
Cache-Control: no-cache
Content-Type: text/html; charset=utf-8
Connection: close

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 — Forbidden</title>
    <style>
      html,body{height:100%;margin:0}
      body{display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;color:#111;background:#f7fafc}
      .card{max-width:720px;width:92%;padding:36px;border-radius:10px;background:white;box-shadow:0 6px 20px rgba(20,20,30,0.06);text-align:left}
      .brand{font-size:12px;color:#6b7280;margin-bottom:8px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase}
      h1{font-size:48px;margin:0 0 6px}
      p{margin:0 0 16px;color:#4b5563}
      .row{display:flex;gap:12px;flex-wrap:wrap}
      a.button{display:inline-block;padding:8px 14px;border-radius:8px;background:#111;color:white;text-decoration:none;font-weight:600}
      a.link{color:#2563eb;text-decoration:underline}
      @media (max-width:560px){h1{font-size:36px}}
    </style>
  </head>
  <body>
    <main class="card" role="main" aria-labelledby="title">
      <div class="brand">Inertia Lighting</div>
      <h1 id="title">403 — Forbidden</h1>
      <p>You don't have permission to access this resource. If you think this is an error, contact the site administrator.</p>

      <div class="row" role="group" aria-label="Navigation links">
        <a class="button" href="/">Home</a>
      </div>

      <p style="margin-top:18px;color:#6b7280;font-size:13px">Include the page URL when contacting support so we can investigate.</p>
    </main>
  </body>
</html>
